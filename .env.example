DATABASE_URL=postgresql://krova:krova@localhost:54329/krova
APP_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_APP_URL=http://localhost:3000

# "/" shows the login page by default. Set to "true" to show the public
# marketing landing page instead (with a link into login).
NEXT_PUBLIC_SHOW_LANDING_PAGE=false

# ── File Storage ───────────────────────────────────────────────────────────────
# "local"  → files saved to ./uploads/ and served via /api/uploads/files/*  (dev)
# "s3"/"r2"→ direct-to-S3 presigned PUT URLs (production)
STORAGE_DRIVER=local
# UPLOAD_DIR=./uploads          # optional — defaults to <project-root>/uploads

# Fill in when switching to s3 or r2:
# S3_ENDPOINT=                  # R2/MinIO only — leave empty for AWS S3
# S3_BUCKET=workflik
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# CDN_URL=https://cdn.example.com

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Optional in local development. Without these, email sends are logged by the worker.
# Works with any SMTP provider: Mailtrap, SendGrid, Postmark, AWS SES, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ── Email Webhook ──────────────────────────────────────────────────────────────
# Optional. Set this to receive delivery events from your SMTP provider.
# Accepts Authorization: Bearer <secret> or x-webhook-secret header.
# EMAIL_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Docker Compose only ────────────────────────────────────────────────────────
# Ignored unless you run `docker compose up` — the compose file builds
# DATABASE_URL from these itself (pointing at the `postgres` service), and
# passes them to the `postgres` container to create the matching database.
# Fine to leave at their defaults for local-only use (nothing but your own
# machine can reach them). If this server is reachable from the internet
# (a VPS, cloud instance, etc.), set a real POSTGRES_PASSWORD below and
# either remove the `ports:` mapping on the `postgres` service in
# docker-compose.yml or firewall port 5432 — otherwise anyone who can reach
# this host can connect directly to your database with the default password.
# POSTGRES_USER=workflik
# POSTGRES_PASSWORD=workflik
# POSTGRES_DB=workflik
# POSTGRES_PORT=5432          # host-side port Postgres is published on
# APP_PORT=3000               # host-side port the app is published on

# Only used by the optional `minio` compose service (--profile extras):
# MINIO_ROOT_USER=workflik
# MINIO_ROOT_PASSWORD=workflik123