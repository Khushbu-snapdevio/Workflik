DATABASE_URL=postgresql://krova:krova@localhost:54329/krova
APP_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── File Storage ───────────────────────────────────────────────────────────────
# "local"  → files saved to ./uploads/ and served via /api/uploads/files/*  (dev)
# "s3"/"r2"→ direct-to-S3 presigned PUT URLs (production)
STORAGE_DRIVER=local
# UPLOAD_DIR=./uploads          # optional — defaults to <project-root>/uploads

# Fill in when switching to s3 or r2:
# S3_ENDPOINT=                  # R2/MinIO only — leave empty for AWS S3
# S3_BUCKET=workflik
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# CDN_URL=https://cdn.example.com

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Optional in local development. Without these, email sends are logged by the worker.
# Works with any SMTP provider: Mailtrap, SendGrid, Postmark, AWS SES, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ── Email Webhook ──────────────────────────────────────────────────────────────
# Optional. Set this to receive delivery events from your SMTP provider.
# Accepts Authorization: Bearer <secret> or x-webhook-secret header.
# EMAIL_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=